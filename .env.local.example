# Copy this file to .env.local and fill in your own values.
# .env.local is gitignored — never commit real keys.

# Supabase — used by the /admin client tracker. Find these under your
# Supabase project: Settings > API.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Analytics — optional. Only loaded after a visitor accepts the cookie
# consent bar. Leave unset to skip analytics entirely.
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_CLARITY_PROJECT_ID=xxxxxxxxxx
