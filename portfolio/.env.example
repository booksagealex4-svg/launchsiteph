# Server-side only — never prefix these with VITE_, or Vite will bundle them into
# the client-side JavaScript and expose them to every visitor's browser.

# Required. Resend API key used by api/send-inquiry.ts to deliver form submissions.
# Create a Resend account at https://resend.com, then generate a key at
# https://resend.com/api-keys. Add this in Vercel under Project Settings -> Environment
# Variables (not in this file, and not committed).
RESEND_API_KEY=

# Optional. The verified "From" address used for outgoing inquiry emails.
# If unset, defaults to Resend's shared sandbox address (onboarding@resend.dev), which
# can only deliver to the email address your Resend account was created with. Once you
# verify a sending domain in Resend (e.g. launchsiteph.com), set this to an address on
# that domain, such as inquiries@launchsiteph.com.
RESEND_FROM_EMAIL=
